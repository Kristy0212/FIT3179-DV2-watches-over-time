{
    "$schema":"https://vega.github.io/schema/vega-lite/v5.json",
    "title":{
        "text": "Production Timeline",
        "subtitle": "When were most watch brand found?",
        "font": "sans-serif",
        "fontSize": 22,
        "fontWeight": "bold",
        "subtitleFont": "san-serif",
        "subtitleFontWeight": "normal",
        "anchor":"start",
        "offset": 10
    },
    "width": 450,
    "height": 300,
    "data":{
        "url": "data/graveyard.json"
    },
    "transform":[
        {
            "filter": "isValid(datum.founded)"
        },
        {
            "calculate": "datum.founded < 1800 ? 'Before 1800' : datum.founded < 1850 ? '1800-1849' : datum.founded < 1900 ? '1850-1899' : datum.founded < 1950 ? '1900-1949' : datum.founded < 2000 ? '1950-1999' : '2000 onwards'",
            "as": "foundingPeriod"
        },
        {
            "calculate": "datum.founded < 1800 ? 1 : datum.founded < 1850 ? 2 : datum.founded < 1900 ? 3 : datum.founded < 1950 ? 4 : datum.founded < 2000 ? 5 : 6",
            "as": "periodOrder"
        }
    ],
    "mark": "bar",
    "encoding":{
        "x":{
            "field": "foundingPeriod",
            "type": "ordinal",
            "title": "Founded Period",
            "sort":{
                "field": "periodOrder",
                "order": "ascending"
            },
            "axis":{
                "labelAngle": 0
            }
        },
        "y":{
            "aggregate": "count",
            "type": "quantitative",
            "title": "Number of Brands"
        },
        "tooltip":[
            {
                "field": "foundingPeriod",
                "type": "ordinal",
                "title": "Founding Period"
            },
            {
                "aggregate": "count",
                "type": "quantitative",
                "title": "Number of Brands"
            }
        ]
    }
}