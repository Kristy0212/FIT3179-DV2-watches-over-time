{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Watch Brand Founding Timeline",
    "subtitle": "When were most watch brands founded?",
    "font": "serif",
    "fontSize": 22,
    "fontWeight": "bold",
    "subtitleFont": "serif",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "anchor": "start",
    "offset": 10
  },
  "vconcat": [
    {
      "width": 500,
      "height": 24,
      "layer": [
        {
          "data": {
            "values": [
              {
                "x": 10,
                "y": 12,
                "icon": "images/watch.svg"
              }
            ]
          },
          "mark": {
            "type": "image",
            "width": 18,
            "height": 18
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative",
              "scale": {
                "domain": [0, 450],
                "range": [-115, 335]
              },
              "axis": null
            },
            "y": {
              "field": "y",
              "type": "quantitative",
              "scale": {
                "domain": [0, 24],
                "range": [24, 0]
              },
              "axis": null
            },
            "url": {
              "field": "icon"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "x": 32,
                "y": 12,
                "legendText": "= 5 brands"
              }
            ]
          },
          "mark": {
            "type": "text",
            "fontSize": 12,
            "color": "#3B2922",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative",
              "scale": {
                "domain": [0, 450],
                "range": [-115, 335]
              },
              "axis": null
            },
            "y": {
              "field": "y",
              "type": "quantitative",
              "scale": {
                "domain": [0, 24],
                "range": [24, 0]
              },
              "axis": null
            },
            "text": {
              "field": "legendText"
            }
          }
        }
      ]
    },
    {
      "width": 500,
      "height": 250,
      "layer": [
        {
          "data": {
            "values": [{}]
          },
          "mark": {
            "type": "rect",
            "fill": "#F7F3EA",
            "stroke": "#BFA58D",
            "strokeWidth": 1.5,
            "cornerRadius": 8
          },
          "encoding": {
            "x": {
              "value": 315
            },
            "x2": {
              "value": 495
            },
            "y": {
              "value": 5
            },
            "y2": {
              "value": 87
            }
          }
        },
        {
          "data": {
            "values": [{}]
          },
          "mark": {
            "type": "point",
            "shape": "triangle-down",
            "size": 180,
            "filled": true,
            "fill": "#F7F3EA",
            "stroke": "#BFA58D",
            "strokeWidth": 1.5
          },
          "encoding": {
            "x": {
              "value": 425
            },
            "y": {
              "value": 94
            }
          }
        },
        {
          "data": {
            "url": "data/watchFoundingIcons.json"
          },
          "mark": {
            "type": "image",
            "width": 30,
            "height": 30
          },
          "encoding": {
            "x": {
              "field": "iconIndex",
              "type": "quantitative",
              "scale": {
                "domain": [-0.5, 12]
              },
              "axis": null
            },
            "y": {
              "field": "foundingPeriod",
              "type": "ordinal",
              "sort": [
                "Before 1800",
                "1800-1849",
                "1850-1899",
                "1900-1949",
                "1950-1999"
              ],
              "axis": {
                "title": "Founding Period",
                "labelFontSize": 12
              }
            },
            "url": {
              "field": "icon"
            }
          }
        },
        {
          "data": {
            "url": "data/watchFoundingIcons.json"
          },
          "transform": [
            {
              "aggregate": [
                {
                  "op": "max",
                  "field": "brandCount",
                  "as": "brandCount"
                },
                {
                  "op": "max",
                  "field": "iconIndex",
                  "as": "lastIconIndex"
                }
              ],
              "groupby": [
                "foundingPeriod",
                "periodOrder"
              ]
            },
            {
              "calculate": "datum.lastIconIndex + 1",
              "as": "labelPosition"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#3B2922",
            "align": "left",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "field": "labelPosition",
              "type": "quantitative",
              "scale": {
                "domain": [-0.5, 12]
              },
              "axis": null
            },
            "y": {
              "field": "foundingPeriod",
              "type": "ordinal",
              "sort": [
                "Before 1800",
                "1800-1849",
                "1850-1899",
                "1900-1949",
                "1950-1999"
              ]
            },
            "text": {
              "field": "brandCount",
              "type": "quantitative"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "heading": "HISTORICAL HIGHLIGHT"
              }
            ]
          },
          "mark": {
            "type": "text",
            "font": "sans-serif",
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#8C6B58",
            "align": "center",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "value": 405
            },
            "y": {
              "value": 23
            },
            "text": {
              "field": "heading"
            }
          }
        },
        {
          "data": {
            "url": "data/watchFoundingIcons.json"
          },
          "transform": [
            {
              "aggregate": [
                {
                  "op": "max",
                  "field": "brandCount",
                  "as": "brandCount"
                }
              ],
              "groupby": [
                "foundingPeriod",
                "periodOrder"
              ]
            },
            {
              "window": [
                {
                  "op": "row_number",
                  "as": "rank"
                }
              ],
              "sort": [
                {
                  "field": "brandCount",
                  "order": "descending"
                },
                {
                  "field": "periodOrder",
                  "order": "ascending"
                }
              ]
            },
            {
              "filter": "datum.rank === 1"
            },
            {
              "calculate": "datum.foundingPeriod === '1850-1899' ? '1850–1899' : datum.foundingPeriod",
              "as": "periodLabel"
            }
          ],
          "mark": {
            "type": "text",
            "font": "sans-serif",
            "fontSize": 20,
            "fontWeight": "bold",
            "color": "#704735",
            "align": "center",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "value": 405
            },
            "y": {
              "value": 46
            },
            "text": {
              "field": "periodLabel"
            }
          }
        },
        {
          "data": {
            "url": "data/watchFoundingIcons.json"
          },
          "transform": [
            {
              "aggregate": [
                {
                  "op": "max",
                  "field": "brandCount",
                  "as": "brandCount"
                }
              ],
              "groupby": [
                "foundingPeriod",
                "periodOrder"
              ]
            },
            {
              "window": [
                {
                  "op": "row_number",
                  "as": "rank"
                }
              ],
              "sort": [
                {
                  "field": "brandCount",
                  "order": "descending"
                },
                {
                  "field": "periodOrder",
                  "order": "ascending"
                }
              ]
            },
            {
              "filter": "datum.rank === 1"
            },
            {
              "calculate": "datum.brandCount + ' brands'",
              "as": "brandLabel"
            }
          ],
          "mark": {
            "type": "text",
            "font": "sans-serif",
            "fontSize": 20,
            "fontWeight": "bold",
            "color": "#704735",
            "align": "center",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "value": 405
            },
            "y": {
              "value": 69
            },
            "text": {
              "field": "brandLabel"
            }
          }
        }
      ]
    }
  ],
  "align": "none",
  "spacing": 18,
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "independent"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "sans-serif",
      "titleFont": "sans-serif"
    }
  }
}