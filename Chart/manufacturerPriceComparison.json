{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "title": {
        "text": "Manufacturer Average Price",
        "subtitle": "How does the average watch price vary across manufacturers?",
        "font": "sans-serif",
        "fontSize": 22,
        "fontWeight": "bold",
        "subtitleFont": "sans-serif",
        "subtitleFontWeight": "normal",
        "anchor": "start",
        "offset": 10
    },

    "width": 450,
    "height": 300,

    "data": {
        "url": "data/manufacturerPriceComparison.json"
    },

    "layer": [

        {
            "mark": {
                "type": "rule",
                "color": "#C8B8A8",
                "strokeWidth": 2
            },

            "encoding": {
                "y": {
                    "field": "brand",
                    "type": "nominal",
                    "sort": {
                        "field": "averagePrice",
                        "order": "descending"
                    },
                    "title": "Manufacturer"
                },

                "x": {
                    "field": "averagePrice",
                    "type": "quantitative"
                },

                "x2": {
                    "value": 0
                }
            }
        },

        {
            "mark": {
                "type": "circle",
                "size": 110,
                "color": "#C8A15A"
            },

            "encoding": {
                "y": {
                    "field": "brand",
                    "type": "nominal",
                    "sort": {
                        "field": "averagePrice",
                        "order": "descending"
                    }
                },

                "x": {
                    "field": "averagePrice",
                    "type": "quantitative",
                    "title": "Average Watch Price (USD)",
                    "axis": {
                        "format": "$,.0f",
                        "grid": false
                    }
                },

                "tooltip": [
                    {
                        "field": "brand",
                        "type": "nominal",
                        "title": "Manufacturer"
                    },
                    {
                        "field": "averagePrice",
                        "type": "quantitative",
                        "title": "Average Price",
                        "format": "$,.0f"
                    }
                ]
            }
        }
    ],

    "config": {
        "view": {
            "stroke": null
        },

        "axis": {
            "labelFont": "sans-serif",
            "titleFont": "sans-serif"
        }
    }
}