{
    "$schema":"https://vega.github.io/schema/vega-lite/v5.json",
    "title":{
        "text": "Historical Watchmaking Hubs",
        "subtitle": "Compare brand counts and the earliest recorded brand year by country",
        "font": "serif",
        "fontSize": 22,
        "fontWeight": "bold",
        "subtitleFont": "serif",
        "subtitleFontWeight": "normal",
        "anchor":"start",
        "offset": 10
    },
    "width": "container",
  "height": 500,

  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
    "projection": {
    "type": "equalEarth",
    "scale": {
      "expr": "zoomScale"
    },
    "center":{
      "expr": "focusCenter"
    },
    "translate": {
        "expr": "[width / 2, height / 2]"
    }
  },

  "params": [
    {
      "name": "selectedCountry",
      "value": "All countries"
    },
    {
      "name": "zoomScale",
      "value": 185
    },
    {
      "name": "focusCenter",
      "value": [0,0]
    }
  ],
    "layer":[
        {
            "data":{
                "url": "data/ne_110m_admin_0_countries.topojson",
                "format":{
                    "type": "topojson",
                    "feature": "ne_110m_admin_0_countries"
                }
            },
            "transform": [
                {
                "lookup": "properties.NAME",
                "from":{
                    "data": {
                        "url": "/data/globalEmergenceFlow.json"
                    },
                    "key": "country",
                    "fields": [
                        "earliestYear",
                        "earliestBrand",
                        "brandCount",
                        "order"
                    ]
                }
            }
        ],
        "mark":{
        "type": "geoshape",
        "fill": "#E8E1D5",
        "stroke": "white",
        "strokeWidth": 0.5
        },
        "encoding":{
            "tooltip":[
                {
                    "field": "properties.NAME",
                    "type": "nominal",
                    "title": "Country"
                },
                {
                    "field": "earliestYear",
                    "type": "quantitative",
                    "title": "Earliest year"
                },
                {
                    "field": "earliestBrand",
                    "type": "nominal",
                    "title": "Earliest brand"
                },
                {
                    "field": "order",
                    "type": "quantitative",
                    "title": "Emergence order"
                }
            ]
            }
        },
        {
            "data":{
                "url":"data/ne_110m_admin_0_countries.topojson",
                "format":{
                    "type": "topojson",
                    "feature": "ne_110m_admin_0_countries"
                }
            },
            "transform": [
                {
                    "lookup": "properties.NAME",
                    "from":{
                        "data": {
                            "url": "data/globalEmergenceFlow.json"
                        },
                        "key": "country",
                        "fields":[
                            "earliestYear",
                            "earliestBrand",
                            "brandCount",
                            "order"
                        ]
                    }
                },
                {
                    "filter": "isValid(datum.order) && (selectedCountry === 'All countries' || datum.properties.NAME === selectedCountry)"
                },
                {
                    "calculate": "geoCentroid(null,datum)[0]",
                    "as": "longitude"
                },
                {
                    "calculate": "geoCentroid(null,datum)[1]",
                    "as": "latitude"
                }
            ],
            "mark": {
                "type": "circle",
                "opacity": 0.75,
                "stroke": "white",
                "strokeWidth": 1
            },
            "encoding": {
                "longitude":{
                    "field": "longitude",
                    "type": "quantitative"
                },
                "latitude":{
                    "field":"latitude",
                    "type": "quantitative"
                },
                "size": {
                    "field": "brandCount",
                    "type": "quantitative",
                    "title": "Number of brands",
                    "legend": {
                        "orient": "right",
                        "titleOrient": "top",
                        "titleAlign": "right",
                        "titleAnchor": "end"
                    },
                    "scale": {
                        "range": [30, 900]
                    }
                },  
                "color": {
                    "field": "earliestYear",
                    "type": "quantitative",
                    "title": "Earliest recorded year",
                    "legend": {
                        "orient": "right",
                        "titleOrient": "top",
                        "titleAlign": "right",
                        "titleAnchor": "end"
                    },
                    "scale": {
                        "domain": [1700, 2000],
                        "range": [
                            "#DCEFEA",
                            "#A8D5CC",
                            "#5AA89B",
                            "#23695F"
                        ],
                        "clamp": true
                    }
                },
                "tooltip":[
                    {
                        "field": "properties.NAME",
                        "type": "nominal",
                        "title": "Country"
                    },
                    {
                        "field": "earliestYear",
                        "type": "quantitative",
                        "title": "Earliest year"
                    },
                    {
                        "field": "earliestBrand",
                        "type": "nominal",
                        "title": "Earliest brand"
                    },
                    {
                        "field": "order",
                        "type": "quantitative",
                        "title": "Emergence order"
                    },
                    {
                        "field": "brandCount",
                        "type": "quantitative",
                        "title": "Number of brands"
                    }
                ]
            }
        }
    ]
}