
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Historical Watchmaking Hubs",
    "subtitle": "Compare brand counts and the earliest recorded brand year by country",
    "font": "serif",
    "fontSize": 22,
    "fontWeight": "bold",
    "subtitleFont": "serif",
    "subtitleFontWeight": "normal",
    "anchor": "start",
    "offset": 10
  },
  "width": "container",
  "height": 500,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "projection": {
    "type": "equalEarth",
    "scale": { "expr": "zoomScale" },
    "center": { "expr": "focusCenter" },
    "translate": { "expr": "[width / 2, height / 2]" }
  },
  "params": [
    {
      "name": "selectedCountry",
      "value": "All countries"
    },
    {
      "name": "zoomScale",
      "value": 185
    },
    {
      "name": "focusCenter",
      "value": [0, 0]
    }
  ],
  "layer": [
    {
      "name": "baseMap",
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": { "url": "data/globalEmergenceFlow.json" },
            "key": "country",
            "fields": [
              "earliestYear",
              "earliestBrand",
              "brandCount",
              "order"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#E8E1D5",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "earliestYear",
            "type": "quantitative",
            "title": "Earliest year"
          },
          {
            "field": "earliestBrand",
            "type": "nominal",
            "title": "Earliest brand"
          },
          {
            "field": "brandCount",
            "type": "quantitative",
            "title": "Number of brands"
          }
        ]
      }
    },
    {
      "name": "brandBubbles",
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": { "url": "data/globalEmergenceFlow.json" },
            "key": "country",
            "fields": [
              "earliestYear",
              "earliestBrand",
              "brandCount",
              "order"
            ]
          }
        },
        {
          "filter": "isValid(datum.order) && (selectedCountry === 'All countries' || datum.properties.NAME === selectedCountry)"
        },
        {
          "calculate": "geoCentroid(null, datum)[0]",
          "as": "longitude"
        },
        {
          "calculate": "geoCentroid(null, datum)[1]",
          "as": "latitude"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "brandCount",
          "type": "quantitative",
          "title": "Number of brands",
          "scale": { "range": [30, 900] },
          "legend": {
            "orient": "right",
            "titleOrient": "top",
            "titleAlign": "right",
            "titleAnchor": "end"
          }
        },
        "color": {
          "field": "earliestYear",
          "type": "quantitative",
          "title": "Earliest recorded year",
          "scale": {
            "domain": [1700, 2000],
            "range": [
              "#DCEFEA",
              "#A8D5CC",
              "#5AA89B",
              "#23695F"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "right",
            "titleOrient": "top",
            "titleAlign": "right",
            "titleAnchor": "end"
          }
        },
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "earliestYear",
            "type": "quantitative",
            "title": "Earliest year"
          },
          {
            "field": "earliestBrand",
            "type": "nominal",
            "title": "Earliest brand"
          },
          {
            "field": "brandCount",
            "type": "quantitative",
            "title": "Number of brands"
          }
        ]
      }
    },
    {
      "name": "highlightAnnotatedCountries",
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": { "url": "data/globalEmergenceFlow.json" },
            "key": "country",
            "fields": [
              "brandCount",
              "order"
            ]
          }
        },
        {
          "filter": "isValid(datum.order) && indexof(['United Kingdom', 'Switzerland'], datum.properties.NAME) >= 0"
        },
        {
          "filter": "selectedCountry === 'All countries' || datum.properties.NAME === selectedCountry"
        },
        {
          "calculate": "geoCentroid(null, datum)[0]",
          "as": "longitude"
        },
        {
          "calculate": "geoCentroid(null, datum)[1]",
          "as": "latitude"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": false,
        "stroke": "#E53935",
        "strokeWidth": 2.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "brandCount",
          "type": "quantitative",
          "scale": { "range": [30, 900] },
          "legend": null
        },
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Highlighted country"
          },
          {
            "field": "brandCount",
            "type": "quantitative",
            "title": "Number of brands"
          }
        ]
      }
    },
    {
      "name": "annotationLines",
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": { "url": "data/globalEmergenceFlow.json" },
            "key": "country",
            "fields": [
              "earliestYear",
              "earliestBrand",
              "brandCount",
              "order"
            ]
          }
        },
        {
          "filter": "isValid(datum.order) && indexof(['United Kingdom', 'Switzerland'], datum.properties.NAME) >= 0"
        },
        {
          "filter": "selectedCountry === 'All countries' || datum.properties.NAME === selectedCountry"
        },
        {
          "calculate": "geoCentroid(null, datum)[0]",
          "as": "longitude"
        },
        {
          "calculate": "geoCentroid(null, datum)[1]",
          "as": "latitude"
        },
        {
          "calculate": "datum.properties.NAME === 'United Kingdom' ? -20 : 42",
          "as": "labelLongitude"
        },
        {
          "calculate": "datum.properties.NAME === 'United Kingdom' ? 52 : 43",
          "as": "labelLatitude"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#A8754F",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "labelLongitude"
        },
        "latitude2": {
          "field": "labelLatitude"
        }
      }
    },
    {
      "name": "annotationLabels",
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": { "url": "data/globalEmergenceFlow.json" },
            "key": "country",
            "fields": [
              "earliestYear",
              "earliestBrand",
              "brandCount",
              "order"
            ]
          }
        },
        {
          "filter": "isValid(datum.order) && indexof(['United Kingdom', 'Switzerland'], datum.properties.NAME) >= 0"
        },
        {
          "filter": "selectedCountry === 'All countries' || datum.properties.NAME === selectedCountry"
        },
        {
          "calculate": "datum.properties.NAME === 'United Kingdom' ? -100 : 43",
          "as": "labelLongitude"
        },
        {
          "calculate": "datum.properties.NAME === 'United Kingdom' ? 50 : 42",
          "as": "labelLatitude"
        },
        {
          "calculate": "datum.properties.NAME === 'United Kingdom' ? 'EARLIEST RECORDED FOUNDING\\nUnited Kingdom\\nGraham (1695)' : 'INTERESTING CONTRAST\\nSwitzerland\\n123 brands | Blancpain (1735)'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "font": "sans-serif",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#4B2E22",
        "align": "left",
        "lineBreak": "\n",
        "lineHeight": 16
      },
      "encoding": {
        "longitude": {
          "field": "labelLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "labelLatitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#FFFFFF",
    "view": { "stroke": null },
    "axis": {
      "labelFont": "sans-serif",
      "titleFont": "sans-serif"
    },
    "title": {
      "color": "#211A16"
    }
  }
}
