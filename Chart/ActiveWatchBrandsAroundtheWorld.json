{
    "$schema":"https://vega.github.io/schema/vega-lite/v5.json",
    "title":{
        "text": "Active Watch Brands Around the World",
        "subtitle": "Where are watch brands still active today?",
        "font": "sans-serif",
        "fontSize": 22,
        "fontWeight": "bold",
        "subtitleFont": "sans-serif",
        "subtitleFontWeight": "normal",
        "anchor":"start",
        "offset": 10
    },
    "width": 450,
    "height": 300,
    "data":{
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format":{
            "type": "topojson",
            "feature": "ne_110m_admin_0_countries"
        }
    },
    "transform":[
        {
            "lookup": "properties.NAME",
            "from":{
                "data":{
                    "url": "data/globalActiveCounts.json"
                },
                "key": "origin",
                "fields": ["activeCount"]
            }
        }
    ],
    "mark":{
        "type": "geoshape"
    },
    "encoding":{
        "color":{
            "condition":{
                "test": "isValid(datum.activeCount)",
                "field": "activeCount",
                "type": "quantitative",
                "title": "Active watch brands",
                "scale": {
                    "domain": [0, 5, 15, 30, 60, 120],
                    "range": [
                        "#f3f0d8",
                        "#d9ef8b",
                        "#a6d96a",
                        "#66bd63",
                        "#1a9850",
                        "#2166ac"
                    ]
                }
            },
            "value": "#D9D3C7"
        },
        "tooltip":[
            {
                "field": "properties.NAME",
                "type": "nominal",
                "title": "Country"
            },
            {
                "field": "activeCount",
                "type": "quantitative",
                "title": "Active Watch brands"
            }
        ]
    }
}