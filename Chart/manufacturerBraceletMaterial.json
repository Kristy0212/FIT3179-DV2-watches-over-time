{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Bracelet & Strap Material Evolution",
    "subtitle": "How have the leading materials changed in rank over time?",
    "font": "serif",
        "fontSize": 22,
        "fontWeight": "bold",
        "subtitleFont": "serif",
        "subtitleFontWeight": "normal",
        "anchor":"start",
        "offset": 10
  },
  "data": {
    "url": "data/braceletMaterialEvolution.json"
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "watchCount",
          "as": "overallWatchCount"
        }
      ],
      "groupby": ["materialGroup"]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "overallRank"
        }
      ],
      "sort": [
        {
          "field": "overallWatchCount",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.overallRank <= 3"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "selectedRank"
        }
      ],
      "groupby": ["productionPeriod"],
      "sort": [
        {
          "field": "watchCount",
          "order": "descending"
        }
      ]
    }
  ],
  "width": 1150,
  "height": 300,
  "encoding": {
    "x": {
      "field": "productionPeriod",
      "type": "ordinal",
      "sort": [
        "Before 1950",
        "1950-1969",
        "1970-1989",
        "1990-2009",
        "2010+"
      ],
      "axis": {
        "title": "Production Period",
        "labelAngle": -90,
        "labelFontSize": 12,
        "titleFontSize": 14
      }
    },
    "y": {
      "field": "selectedRank",
      "type": "quantitative",
      "scale": {
        "domain": [1, 4],
        "reverse": true
      },
      "axis": {
        "title": "Material Rank",
        "values": [1, 2, 3, 4],
        "labelFontSize": 12,
        "titleFontSize": 14
      }
    },
    "color": {
      "field": "materialGroup",
      "type": "nominal",
      "title": "Material",
      "scale": {
        "domain": [
          "Steel",
          "Gold / Gold combination",
          "Leather / Animal skin"
        ],
        "range": [
          "#8B694B",
          "#C9A45D",
          "#E9A052"
        ]
      },
      "legend": {
        "orient": "right"
      }
    },
    "detail": {
      "field": "materialGroup"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100
      },
      "encoding": {
        "tooltip": [
          {
            "field": "productionPeriod",
            "title": "Production Period"
          },
          {
            "field": "materialGroup",
            "title": "Material"
          },
          {
            "field": "selectedRank",
            "title": "Rank"
          },
          {
            "field": "percentage",
            "title": "Share (%)",
            "format": ".1f"
          },
          {
            "field": "watchCount",
            "title": "Watch Count",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "axis": {
      "grid": true,
      "domainColor": "#999999",
      "tickColor": "#999999"
    },
    "legend": {
      "titleFontSize": 13,
      "labelFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}
