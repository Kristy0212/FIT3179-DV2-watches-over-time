
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Global Origins of Watch Brands",
    "subtitle": "Where did watch brands originate?",
    "font": "serif",
    "fontSize": 26,
    "fontWeight": "bold",
    "subtitleFont": "serif",
    "subtitleFontSize": 15,
    "subtitleFontWeight": "normal",
    "anchor": "start",
    "offset": 12
  },

  "width": "container",
  "height": 500,

  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },

  "projection": {
    "type": "equalEarth",
    "scale": {
      "expr": "zoomScale"
    },
    "center":{
      "expr": "focusCenter"
    },
    "translate": {
      "expr": "[width / 2, height / 2]"
    }
  },

  "params": [
    {
      "name": "selectedCountry",
      "value": "All countries"
    },
    {
      "name": "zoomScale",
      "value": 185
    },
    {
      "name": "focusCenter",
      "value": [0,0]
    }
  ],

  "data": {
    "url": "data/ne_110m_admin_0_countries.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_110m_admin_0_countries"
    }
  },

  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "fill": "#E6DED2",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      },

      "encoding": {
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "data/globalOriginCounts.json"
            },
            "key": "origin",
            "fields": [
              "manufacturerCount",
              "manufacturerPercentage"
            ]
          }
        },
        {
          "filter": "isValid(datum.manufacturerPercentage) && (selectedCountry === 'All countries' || datum.properties.NAME === selectedCountry)"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      },

      "encoding": {
        "color": {
          "field": "manufacturerPercentage",
          "type": "quantitative",
          "title": "Share of brands (%)",

          "scale": {
            "type": "linear",
            "domain": [0, 30],
            "range": [
              "#C49A6C",
              "#A8754F",
              "#875A3C",
              "#4B2E22"
            ],
            "clamp": true
          },

          "legend": {
            "orient": "right",
            "direction": "vertical",
            "offset": 20,
            "titleAnchor": "end",
            "titlePadding": 14,
            "gradientLength": 250,
            "gradientThickness": 20,
            "labelFontSize": 13,
            "titleFontSize": 14
          }
        },

        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "manufacturerCount",
            "type": "quantitative",
            "title": "Number of brands",
            "format": ",.0f"
          },
          {
            "field": "manufacturerPercentage",
            "type": "quantitative",
            "title": "Share of brands (%)",
            "format": ".2f"
          }
        ]
      }
    }
  ],

  "config": {
    "background": "#FFFFFF",

    "view": {
      "stroke": null
    },

    "axis": {
      "labelFont": "sans-serif",
      "titleFont": "sans-serif"
    },

    "title": {
      "color": "#211A16"
    }
  }
}
