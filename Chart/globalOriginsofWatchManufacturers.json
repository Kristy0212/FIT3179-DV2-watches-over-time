
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global Origins of Watch Brands",
    "subtitle": "Where did watch brands originate?",
    "font": "sans-serif",
    "fontSize": 22,
    "fontWeight": "bold",
    "subtitleFont": "sans-serif",
    "subtitleFontWeight": "normal",
    "anchor": "start",
    "offset": 10
  },
  "width": 1100,
  "height": 450,
  "projection": {
    "type": "equalEarth"
  },
  "data": {
    "url": "data/ne_110m_admin_0_countries.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_110m_admin_0_countries"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "fill": "#E6DED2",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "data/globalOriginCounts.json"
            },
            "key": "origin",
            "fields": [
              "manufacturerCount",
              "manufacturerPercentage"
            ]
          }
        },
        {
          "filter": "isValid(datum.manufacturerPercentage)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "field": "manufacturerPercentage",
          "type": "quantitative",
          "title": "Share of brands (%)",
          "scale": {
            "type": "linear",
            "domain": [0, 30],   
            "range": [
            "#DCC8AC",
            "#B98A61",
            "#8D5E3D",
            "#634032"
            ],
            "clamp": true
          },
          "legend": {
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "manufacturerCount",
            "type": "quantitative",
            "title": "Number of brands",
            "format": ",.0f"
          },
          {
            "field": "manufacturerPercentage",
            "type": "quantitative",
            "title": "Share of brands (%)",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
